<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mio" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/mio_background</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Mio.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mio_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Mio</item>
    </style>
</resources>
